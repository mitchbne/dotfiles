# Theme (try: ghostty +list-themes to see all options)
theme = Dracula

# Font (MonoLisa primary, Symbols Nerd Font as fallback for icons)
font-family = MonoLisa
font-family = Symbols Nerd Font Mono
font-family-bold = MonoLisa Bold
font-family-italic = MonoLisa Regular Italic
font-family-bold-italic = MonoLisa Bold Italic
font-size = 16

# Window
window-padding-x = 12
window-padding-y = 8
window-decoration = true
macos-titlebar-style = tabs

# Cursor
cursor-style = bar
cursor-style-blink = false

# Shell integration (enables marks, completions, etc.)
shell-integration = zsh

# Natural Text Editing (matches iTerm2's preset)
# Word movement
keybind = alt+left=esc:b
keybind = alt+right=esc:f
# Line movement
keybind = super+left=text:\x01
keybind = super+right=text:\x05
# Word deletion
keybind = alt+backspace=text:\x1b\x7f
keybind = super+backspace=text:\x15
# Selection by character
keybind = shift+left=text:\x1b[1;2D
keybind = shift+right=text:\x1b[1;2C
keybind = shift+up=text:\x1b[1;2A
keybind = shift+down=text:\x1b[1;2B
# Selection by word
keybind = alt+shift+left=text:\x1b[1;4D
keybind = alt+shift+right=text:\x1b[1;4C
# Selection to start/end of line
keybind = super+shift+left=text:\x1b[1;2H
keybind = super+shift+right=text:\x1b[1;2F
